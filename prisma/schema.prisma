// Prisma Schema for Sweety - Blood Glucose Tracker
// Database: PostgreSQL (Cloud Neon)
// Timezone: Asia/Kolkata

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TimeSlot {
  MORNING_FASTING
  AFTER_BREAKFAST
  AFTER_LUNCH
  AFTER_DINNER
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String    // bcrypt hash
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  readings  Reading[]

  @@map("users")
}

model Reading {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingDate  DateTime  @db.Date @map("reading_date")
  timeSlot     TimeSlot  @map("time_slot")
  glucoseValue Int       @map("glucose_value")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, readingDate, timeSlot], name: "unique_user_date_slot")
  @@index([userId, readingDate])
  @@map("readings")
}
